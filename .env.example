PORT=3000

# Supabase credentials (from your Supabase project settings)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Apple Sign In (from Apple Developer Console)
# Required only if you want backend-level Apple token verification
APPLE_TEAM_ID=your-team-id
APPLE_CLIENT_ID=com.fitguard.app

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://fit-guard.fitness
